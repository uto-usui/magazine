<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 420" width="800" height="420" font-family="'Hiragino Sans','Hiragino Kaku Gothic ProN','Noto Sans JP','Yu Gothic',sans-serif">
  <title>オントロジーとスキーマの違い</title>
  <desc>左はオントロジー：文書→法的文書→契約という上下関係と、当事者・期間・条項などの決まりを網羅した定義。右はスキーマ：拾う種類と関係だけを数行で書いたリスト。</desc>
  <rect width="800" height="420" fill="#ffffff"/>

  <!-- 左：オントロジー -->
  <rect x="24" y="24" width="364" height="372" rx="12" fill="#f3f0f8" stroke="#d9d3e3"/>
  <text x="48" y="58" font-size="18" font-weight="700" fill="#221d2e">オントロジー</text>
  <text x="48" y="80" font-size="12.5" fill="#6e6680">分野の概念と決まりを、すべて定義する</text>

  <!-- 上下関係の木 -->
  <g stroke="#6e6680" stroke-width="1.4" fill="none">
    <line x1="206" y1="126" x2="206" y2="150"/>
    <line x1="206" y1="176" x2="206" y2="200"/>
    <line x1="206" y1="226" x2="206" y2="252"/>
    <line x1="206" y1="226" x2="100" y2="252"/>
    <line x1="206" y1="226" x2="312" y2="252"/>
    <line x1="312" y1="278" x2="312" y2="304"/>
  </g>
  <g font-size="10.5" fill="#6e6680">
    <rect x="212" y="130" width="34" height="16" rx="8" fill="#f3f0f8"/><text x="229" y="142" text-anchor="middle">is-a</text>
    <rect x="212" y="180" width="34" height="16" rx="8" fill="#f3f0f8"/><text x="229" y="192" text-anchor="middle">is-a</text>
    <rect x="130" y="228" width="44" height="16" rx="8" fill="#f3f0f8"/><text x="152" y="240" text-anchor="middle">当事者</text>
    <rect x="212" y="232" width="34" height="16" rx="8" fill="#f3f0f8"/><text x="229" y="244" text-anchor="middle">期間</text>
    <rect x="252" y="228" width="44" height="16" rx="8" fill="#f3f0f8"/><text x="274" y="240" text-anchor="middle">構成</text>
    <rect x="318" y="282" width="44" height="16" rx="8" fill="#f3f0f8"/><text x="340" y="294" text-anchor="middle">支払い</text>
  </g>
  <g text-anchor="middle" font-size="12" fill="#221d2e">
    <rect x="166" y="102" width="80" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="206" y="120">文書</text>
    <rect x="166" y="152" width="80" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="206" y="170">法的文書</text>
    <rect x="166" y="202" width="80" height="26" rx="13" fill="#221d2e"/><text x="206" y="220" fill="#ffffff" font-weight="700">契約</text>
    <rect x="40" y="254" width="124" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="102" y="272">人・会社（2者以上）</text>
    <rect x="160" y="254" width="92" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="206" y="272">開始日・終了日</text>
    <rect x="276" y="254" width="72" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="312" y="272">条項</text>
    <rect x="266" y="306" width="92" height="26" rx="13" fill="#ffffff" stroke="#6e6680"/><text x="312" y="324">銀行口座</text>
  </g>
  <g font-size="12" fill="#6e6680">
    <text x="48" y="358">・上下関係や制約まで決める</text>
    <text x="48" y="378">・専門家が先に設計し、正しさが要る</text>
  </g>

  <!-- 右：スキーマ -->
  <rect x="412" y="24" width="364" height="372" rx="12" fill="#efe9ff" stroke="#d9d3e3"/>
  <text x="436" y="58" font-size="18" font-weight="700" fill="#221d2e">スキーマ</text>
  <text x="436" y="80" font-size="12.5" fill="#6e6680">取り出す種類と関係だけを書く</text>

  <!-- メモ風カード -->
  <rect x="436" y="100" width="316" height="196" rx="8" fill="#ffffff" stroke="#6510f4"/>
  <text x="452" y="126" font-size="11.5" fill="#6510f4" font-weight="700">拾う種類</text>
  <g font-size="12.5" fill="#221d2e" text-anchor="middle">
    <rect x="452" y="136" width="44" height="26" rx="13" fill="#efe9ff"/><text x="474" y="154">人</text>
    <rect x="504" y="136" width="56" height="26" rx="13" fill="#6510f4"/><text x="532" y="154" fill="#ffffff" font-weight="700">契約</text>
    <rect x="568" y="136" width="56" height="26" rx="13" fill="#efe9ff"/><text x="596" y="154">日付</text>
    <rect x="632" y="136" width="56" height="26" rx="13" fill="#efe9ff"/><text x="660" y="154">条項</text>
    <rect x="452" y="170" width="80" height="26" rx="13" fill="#efe9ff"/><text x="492" y="188">銀行口座</text>
  </g>
  <text x="452" y="226" font-size="11.5" fill="#6510f4" font-weight="700">つながり</text>
  <g font-size="12.5" fill="#221d2e">
    <text x="452" y="250">契約 ── 人　　（当事者）</text>
    <text x="452" y="274">契約 ── 日付　（期間）</text>
  </g>

  <g font-size="12" fill="#6e6680">
    <text x="436" y="328">・抽出の目印。分野を正しく表す必要はない</text>
    <text x="436" y="358">・PythonのクラスかJSONで数行</text>
    <text x="436" y="378">・使いながら足す・直す</text>
  </g>
</svg>

<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="800" height="600" font-family="'Hiragino Sans','Hiragino Kaku Gothic ProN','Noto Sans JP','Yu Gothic',sans-serif">
  <title>同じ記事から作った2つのグラフの、イベントのまわり</title>
  <desc>上はスキーマなし：JSAI 2026とフロントエンドカンファレンス福岡2026は、協賛の告知と参加レポートがそれぞれ別のイベントノードにつながる。MIRU 2026は1つにまとまるが、告知記事から令和8年熊本地震もイベントとして拾われる。下はスキーマあり：3つとも、告知とレポートの2本がabout_eventで1つのEventノードにつながる。</desc>
  <defs><marker id="mg" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#8d8599"/></marker><marker id="mp" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="#6510f4"/></marker></defs>
  <rect width="800" height="600" fill="#ffffff"/>
  <rect x="20" y="16" width="760" height="290" rx="12" fill="#f3f0f8" stroke="#d9d3e3"/>
  <text x="40" y="48" font-size="18" font-weight="700" fill="#221d2e">スキーマなし</text>
  <text x="156" y="48" font-size="12.5" fill="#6e6680">記事から拾われた「event」ノード</text>
  <line x1="273" y1="68" x2="273" y2="262" stroke="#d9d3e3" stroke-dasharray="2 4"/>
  <line x1="527" y1="68" x2="527" y2="262" stroke="#d9d3e3" stroke-dasharray="2 4"/>
  <text x="146" y="76" font-size="11.5" fill="#6e6680" text-anchor="middle">JSAI 2026</text>
  <text x="400" y="76" font-size="11.5" fill="#6e6680" text-anchor="middle">フロントエンドカンファレンス福岡</text>
  <text x="654" y="76" font-size="11.5" fill="#6e6680" text-anchor="middle">MIRU 2026</text>
  <rect x="30" y="86" width="112" height="28" rx="6" fill="#ffffff" stroke="#8d8599"/>
  <text x="86" y="104" font-size="11" fill="#221d2e" text-anchor="middle">記事：協賛の告知</text>
  <rect x="150" y="86" width="112" height="28" rx="6" fill="#ffffff" stroke="#8d8599"/>
  <text x="206" y="104" font-size="11" fill="#221d2e" text-anchor="middle">記事：参加レポート</text>

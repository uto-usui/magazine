  <text x="714" y="104" font-size="11" fill="#221d2e" text-anchor="middle">記事：参加レポート</text>
  <line x1="602" y1="114" x2="676" y2="180" stroke="#8d8599" stroke-width="1.6" marker-end="url(#mg)"/>
  <line x1="714" y1="114" x2="692" y2="180" stroke="#8d8599" stroke-width="1.6" marker-end="url(#mg)"/>
  <line x1="588" y1="114" x2="578" y2="180" stroke="#8d8599" stroke-width="1.6" marker-end="url(#mg)"/>
  <circle cx="688" cy="194" r="12" fill="#6510f4"/>
  <text x="688" y="224" font-size="10.5" fill="#221d2e" text-anchor="middle" font-weight="700">miru2026</text>
  <text x="688" y="237" font-size="9.5" fill="#6e6680" text-anchor="middle">（第29回…）</text>
  <circle cx="576" cy="194" r="12" fill="#e3a46f"/>
  <text x="576" y="224" font-size="10.5" fill="#221d2e" text-anchor="middle" font-weight="700">令和8年熊本地震</text>
  <text x="576" y="237" font-size="9.5" fill="#6e6680" text-anchor="middle">イベント扱いに</text>
  <text x="146" y="288" font-size="11.5" font-weight="700" fill="#b4530a" text-anchor="middle">告知とレポートが別のノードに</text>
  <text x="400" y="288" font-size="11.5" font-weight="700" fill="#b4530a" text-anchor="middle">表記ゆれで別のノードに</text>
  <text x="654" y="288" font-size="11.5" font-weight="700" fill="#b4530a" text-anchor="middle">まとまったが、地震もevent</text>
  <rect x="20" y="322" width="760" height="262" rx="12" fill="#efe9ff" stroke="#6510f4"/>
  <text x="40" y="354" font-size="18" font-weight="700" fill="#221d2e">スキーマあり</text>
  <text x="156" y="354" font-size="12.5" fill="#6e6680">Event ノードと about_event のつながり</text>

  <text x="86" y="410" font-size="11" fill="#221d2e" text-anchor="middle">記事：協賛の告知</text>
  <rect x="150" y="392" width="112" height="28" rx="6" fill="#ffffff" stroke="#8d8599"/>
  <text x="206" y="410" font-size="11" fill="#221d2e" text-anchor="middle">記事：参加レポート</text>
  <line x1="86" y1="420" x2="137" y2="490" stroke="#6510f4" stroke-width="1.6" marker-end="url(#mp)"/>
